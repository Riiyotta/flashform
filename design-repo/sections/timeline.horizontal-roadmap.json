{
  "id": "timeline.horizontal-roadmap",
  "kind": "section",
  "category": "scroll-stage",
  "purpose": "Project roadmap: current milestone in a giant numeral, then a horizontally scrolled hand-drawn curve with three dated milestones. Desktop only.",
  "implementedBy": [
    "src/components/Roadmap.jsx",
    "src/anim/scrollFx.js"
  ],
  "variants": [],
  "constraints": {
    "onePerPage": true,
    "maxPerPage": 1,
    "desktopOnly": true
  },
  "content": {
    "schemaRef": "#/definitions/content.timeline.horizontal-roadmap",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "paragraph",
        "current",
        "milestones"
      ],
      "properties": {
        "heading": {
          "$ref": "#/definitions/runs"
        },
        "paragraph": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "month",
            "day"
          ],
          "properties": {
            "label": {
              "$ref": "#/definitions/braced"
            },
            "month": {
              "type": "string",
              "minLength": 1
            },
            "day": {
              "$ref": "#/definitions/day"
            }
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "month",
              "day",
              "title"
            ],
            "properties": {
              "month": {
                "type": "string",
                "minLength": 1
              },
              "day": {
                "$ref": "#/definitions/day"
              },
              "title": {
                "$ref": "#/definitions/braced"
              }
            }
          }
        }
      }
    },
    "wordBudgets": [
      {
        "path": "heading",
        "observedMaxWords": 2,
        "maxWords": 3
      },
      {
        "path": "paragraph",
        "observedMaxWords": 21,
        "maxWords": 26
      },
      {
        "path": "current.label",
        "observedMaxWords": 2,
        "maxWords": 3
      },
      {
        "path": "milestones[].title",
        "observedMaxWords": 3,
        "maxWords": 4
      }
    ]
  },
  "assetRoles": [],
  "motion": {
    "allowedPatterns": [
      "reveal-on-view",
      "horizontal-scroll",
      "roadmap-draw"
    ],
    "reducedMotionFallback": "curve-fully-drawn",
    "revealTargets": [
      "heading-chars",
      "paragraph-lines",
      "rise",
      "fade"
    ],
    "inViewThresholds": [
      0.4
    ]
  },
  "responsive": [
    {
      "maxWidth": "1060",
