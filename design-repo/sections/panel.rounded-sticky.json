{
  "id": "panel.rounded-sticky",
  "kind": "section",
  "category": "panel",
  "purpose": "An accent-green rounded card that scales in and pins while its long right column scrolls inside it: problem/solution or benefit lists.",
  "implementedBy": [
    "src/components/RoundedSection.jsx",
    "src/components/Purpose.jsx",
    "src/components/Problems.jsx"
  ],
  "variants": [
    "with-channel-list",
    "items-only"
  ],
  "constraints": {
    "maxPerPage": 2,
    "variantsUniquePerPage": true
  },
  "content": {
    "schemaRef": "#/definitions/content.panel.rounded-sticky",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "items"
      ],
      "properties": {
        "heading": {
          "$ref": "#/definitions/runs"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "icon",
              "title",
              "paragraphs"
            ],
            "properties": {
              "icon": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetRole",
                  "assetRef"
                ],
                "properties": {
                  "assetRole": {
                    "enum": [
                      "icon.feature-glyph"
                    ]
                  },
                  "assetRef": {
                    "$ref": "#/definitions/assetRef"
                  }
                }
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "channelList": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "icon"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "assetRole",
                        "assetRef"
                      ],
                      "properties": {
                        "assetRole": {
                          "enum": [
                            "icon.third-party-channel",
                            "icon.generic-channel"
                          ]
                        },
                        "assetRef": {
                          "$ref": "#/definitions/assetRef"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "wordBudgets": [
      {
        "path": "heading",
        "observedMaxWords": 4,
        "maxWords": 5
      },
      {
        "path": "items[].title",
        "observedMaxWords": 8,
        "maxWords": 10
      },
      {
        "path": "items[].paragraphs[]",
        "observedMaxWords": 48,
        "maxWords": 58
      },
      {
        "path": "items[].channelList[].name",
        "observedMaxWords": 2,
        "maxWords": 3
      }
    ]
  },
  "assetRoles": [
    "icon.feature-glyph",
    "icon.generic-channel",
    "icon.third-party-channel"
  ],
  "motion": {
    "allowedPatterns": [
      "section-scale",
      "sticky-inner-scroll"
    ],
    "reducedMotionFallback": "static-final-state",
    "revealTargets": [],
    "inViewThresholds": []
  },
