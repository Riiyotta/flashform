{
  "id": "shell.footer",
  "kind": "section",
  "category": "shell",
  "purpose": "Close with a playful physics \"STAY IN TOUCH\" letter drop, contact links, the beta sign-up form and legal links.",
  "implementedBy": [
    "src/components/Footer.jsx",
    "src/anim/fallingLetters.js"
  ],
  "variants": [],
  "constraints": {
    "onePerPage": true,
    "maxPerPage": 1,
    "mustBeLast": true
  },
  "content": {
    "schemaRef": "#/definitions/content.shell.footer",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo",
        "physicsWords",
        "contact",
        "subscribe",
        "legal"
      ],
      "properties": {
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "assetRef"
          ],
          "properties": {
            "assetRole": {
              "enum": [
                "brand.logo"
              ]
            },
            "assetRef": {
              "$ref": "#/definitions/assetRef"
            }
          }
        },
        "physicsWords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "links"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/definitions/externalLink"
              }
            }
          }
        },
        "subscribe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "emailLabel",
            "submitLabel"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "emailLabel": {
              "type": "string",
              "minLength": 1
            },
            "submitLabel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "legal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "copyright",
            "links",
            "credit"
          ],
          "properties": {
            "copyright": {
              "type": "string",
              "minLength": 1
            },
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/definitions/externalLink"
              }
            },
            "credit": {
              "$ref": "#/definitions/externalLink"
            }
          }
        }
      }
    },
    "wordBudgets": [
      {
        "path": "contact.heading",
        "observedMaxWords": 2,
        "maxWords": 3
      },
      {
        "path": "contact.links[].label",
        "observedMaxWords": 1,
        "maxWords": 2
      },
      {
        "path": "subscribe.heading",
        "observedMaxWords": 3,
        "maxWords": 4
      },
      {
        "path": "legal.links[].label",
        "observedMaxWords": 3,
        "maxWords": 4
      },
      {
        "path": "legal.credit.label",
        "observedMaxWords": 2,
        "maxWords": 3
      }
    ]
  },
  "assetRoles": [
    "brand.logo"
  ],
  "motion": {
    "allowedPatterns": [
      "physics-letters"
    ],
    "reducedMotionFallback": "static-empty-area",
    "revealTargets": [],
    "inViewThresholds": []
  },
  "responsive": [
    {
      "maxWidth": "1060",
