{
  "version": "1.0.0",
  "$description": "Closed asset-role vocabulary. Every PageSpec media field is {assetRole, assetRef}; assetRole must be one of the settable roles below, and assetRef must be a registered id of that role (asset:...), or owner-supplied:<slot> / generated:<slot> when the policy allows it.",
  "sourceIsRealCompany": true,
  "licensing": {
    "summary": "Flashform (flshfrm.com) is a real, live product site built by Emotion Agency. Its copy, videos, OG image, logo and favicon are the original owner's proprietary content. The messenger icons are third-party trademarks. The fonts are commercial typefaces. None of this may be reproduced in generated output except as stated per role; the bundled example PageSpec reproduces the original only as a fidelity reference (contentProvenance 'original-reference').",
    "forbidden": [
      "AI-generating or redrawing any real logo or brand mark (Flashform, WhatsApp, Telegram, Messenger, Discord)",
      "depicting real people (no generated portraits, no employee or customer likenesses)",
      "reusing the original's videos, screencast, OG image or copy in a new-content page",
      "reusing the original's contact channels (agency email, personal WhatsApp/Telegram) or its third-party form endpoint"
    ]
  },
  "policies": {
    "must-reuse-exact": "Reference the registered asset by id, unmodified. Never regenerate, redraw, restyle or approximate it.",
    "must-not-fabricate": "A real trademark or third-party brand mark. Never AI-generate, redraw or imitate it. Use only the official asset obtained from the mark owner under their brand guidelines, or omit it.",
    "owner-supplied-only": "The original's proprietary media. Never reuse it in a generated page and never AI-generate a look-alike. Leave an owner-supplied slot (assetRef 'owner-supplied:<slot>') that the page owner fills with media they hold rights to.",
    "may-generate-new": "New artwork may be generated, within the stated style constraints. It must not depict real people, real logos, or copy the original artwork."
  },
  "pinnedPolicies": {
    "brand.logo": "must-not-fabricate",
    "meta.favicon": "must-not-fabricate",
    "icon.third-party-channel": "must-not-fabricate",
    "media.loop-video-square": "owner-supplied-only",
    "media.product-screencast": "owner-supplied-only",
    "meta.og-image": "owner-supplied-only",
    "font.commercial": "must-reuse-exact"
  },
  "refRules": {
    "asset:": "registered id; must belong to the field role",
    "owner-supplied:": "allowed for owner-supplied-only and may-generate-new roles; the page owner provides media they hold rights to",
    "generated:": "allowed only for may-generate-new roles"
  },
